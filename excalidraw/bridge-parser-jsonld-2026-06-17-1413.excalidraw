    {
      "id": "2xLnGDMiTYaSX2RAVelsV",
      "type": "text",
      "x": 4329.725220968006,
      "y": -259.74588527194214,
      "width": 1323.324951171875,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCZ",
      "roundness": null,
      "seed": 2075317767,
      "version": 365,
      "versionNonce": 122127571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781723472030,
      "link": null,
      "locked": false,
      "text": "//P représente l'entité personne\n//Recipe représente le mapping de la transformation à effectuer\n//À gauche, c'est l'objet final de jsonLD mettons\n//À droite, comment trouver la propriété, dans notre document mongo.\nconst recipe = {\n    \"P.@type\":\"P.type\",\n    \"P.name\":\"P.firstName\"+\" \"+\"P.lastName\",\n    \n    //Imaginons une organisation O\n    \"O.ownsInventory.*\":\"O.equipements.*\",\n    //Ou bien, si chaque objet dans l'array a un définition différent du notre\n    \"O.ownsInventory.*.name\": \"O.equipements.*.brand\",\n    \"O.ownsInventory.*.type\": \"O.equipements.*.model\", //etc\n    \"O.skills.*\": \"O.*.name.subName.order, O.*.name.subName.meta\"\n}",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "//P représente l'entité personne\n//Recipe représente le mapping de la transformation à effectuer\n//À gauche, c'est l'objet final de jsonLD mettons\n//À droite, comment trouver la propriété, dans notre document mongo.\nconst recipe = {\n    \"P.@type\":\"P.type\",\n    \"P.name\":\"P.firstName\"+\" \"+\"P.lastName\",\n    \n    //Imaginons une organisation O\n    \"O.ownsInventory.*\":\"O.equipements.*\",\n    //Ou bien, si chaque objet dans l'array a un définition différent du notre\n    \"O.ownsInventory.*.name\": \"O.equipements.*.brand\",\n    \"O.ownsInventory.*.type\": \"O.equipements.*.model\", //etc\n    \"O.skills.*\": \"O.*.name.subName.order, O.*.name.subName.meta\"\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
