      "text": "const compatibilityObject = {\n    Person: {\n        datascene: {\n            \"className\" : \"Contributeur\",\n            fields: {\n                \"category\": {\n                     content: RefPerson.ref.occupations.ref.skills (type référence vers refTaxonomy) refTaxonomy.ref.category\n                     transform: {P.occupations.flatMap(occupations.skills.map(return skill.category) }\n                 }\n            }\n        }\n    }\n}",
