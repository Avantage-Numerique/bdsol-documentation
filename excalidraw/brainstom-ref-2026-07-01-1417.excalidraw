      "link": null,
      "locked": false,
      "text": "jsonLDObject = {}\ncurrentRef = getCompatibilityRef( getRefFactory(pDoc) )\nForEach properties in currentRef.ref\n   if property is compatibility with AvnuOntology\n      jsonLDObject = {...jsonLDObject, AvnuOntology.propertyName : pDoc[property] }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "jsonLDObject = {}\ncurrentRef = getCompatibilityRef( getRefFactory(pDoc) )\nForEach properties in currentRef.ref\n   if property is compatibility with AvnuOntology\n      jsonLDObject = {...jsonLDObject, AvnuOntology.propertyName : pDoc[property] }",
