    {
      "id": "-qTdhxWPzUpWnK9BuZiHA",
      "type": "text",
      "x": -1675.2444848537202,
      "y": -38.44896866864451,
      "width": 862.375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b04V",
      "roundness": null,
      "seed": 1249619048,
      "version": 1608,
      "versionNonce": 801866520,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782933327114,
      "link": null,
      "locked": false,
      "text": "Blueprint : Ref vers AVNU.Personne\nAVNU.context = \"schema.org\"\nAVNU.Personne.givenName = Ref.Personne.firstName;\nAVNU.Personne.fullName = concat(Ref.Personne.firstName + \" \" + Ref.Personne.lastName)\nAVNU.Personne.description = Ref.Personne.description\nAVNU.competences.* = Ref.Personne.*.skillGroup.name",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Blueprint : Ref vers AVNU.Personne\nAVNU.context = \"schema.org\"\nAVNU.Personne.givenName = Ref.Personne.firstName;\nAVNU.Personne.fullName = concat(Ref.Personne.firstName + \" \" + Ref.Personne.lastName)\nAVNU.Personne.description = Ref.Personne.description\nAVNU.competences.* = Ref.Personne.*.skillGroup.name",
      "autoResize": true,
      "lineHeight": 1.25
    },
