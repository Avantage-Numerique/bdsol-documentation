      "text": "RefPerson = {\n   \n    ref: {\n        firstName: {\n            cardinality: \"0..1\",\n            rawType: \"dans-le-document | virtuel | static | programmatic\",\n            compatibility: {\n                datascene: {\n                    \n                }\n            },\n            type: {\n                slug: \"string | createRefType('string')\",\n                label: \"Nom\",\n                description: \"Nom de l'entité\",\n                primitive: {\n                    ...name,\n                    url: createPrimitiveUrl(\"name\"),\n                }\n            }\n        }, \n    },\n\n    refTransformed : {\n        fullName: {\n            cardinality: \"0..1\",\n            rawType: \"virtuel\",\n            compatibility: {\n                datascene: {\n                        \n                }\n            },\n            type: {\n                slug: \"string | createRefType('string')\",\n                label: \"Nom\",\n                description: \"Nom de l'entité\",\n                primitive: {\n                    ...name,\n                    url: createPrimitiveUrl(\"name\"),\n                }\n            }\n        }\n    }\n}",
